import osmium
import osmium
import shapely.wkb
from pyproj import Geod

# Khởi tạo Geod để tính độ dài thực tế theo độ cong Trái Đất
geod = Geod(ellps="WGS84")

class HighwayHandler(osmium.SimpleHandler):
    def __init__(self):
        super().__init__()
        self.wkbf = osmium.geom.WKBFactory()
        self.highways = []

    def way(self, w):
        # Lọc các đường giao thông
        if 'highway' in w.tags:
            is_bridge = w.tags.get('bridge') in ['yes', 'true', '1']
            name = w.tags.get('name', 'Không tên')
            highway_type = w.tags.get('highway')

            try:
                # Tạo LineString từ Way
                wkb_data = self.wkbf.create_linestring(w)
                line = shapely.wkb.loads(bytes.fromhex(wkb_data))
                
                # Tính độ dài thực tế (đơn vị: mét)
                length_meters = round(abs(geod.geometry_length(line)), 2)

                self.highways.append({
                    'id': w.id,
                    'name': name,
                    'type': highway_type,
                    'is_bridge': is_bridge,
                    'length_meters': length_meters
                })
            # Sửa đoạn này: Bắt thêm lỗi InvalidLocationError của osmium
            except (RuntimeError, osmium.InvalidLocationError, Exception):
                # Bỏ qua các đoạn đường thiếu tọa độ nút
                pass

# === CHẠY CHƯƠNG TRÌNH ===
handler = HighwayHandler()

# Đổi đường dẫn tới file hanoi.osm.pbf của bạn
handler.apply_file("hanoi.osm.pbf", locations=True)

print(f"Đã xử lý xong! Lấy thành công {len(handler.highways)} đoạn đường.\n")

# In ra 10 đoạn đường mẫu
for road in handler.highways[:10]:
    print(f"ID: {road['id']} | Tên: {road['name']} | Loại: {road['type']} | Cầu: {road['is_bridge']} | Dài: {road['length_meters']}m")